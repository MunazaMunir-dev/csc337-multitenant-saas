# API
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:123@localhost:5432/multitenant_saas
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Kafka - local Redpanda defaults
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=csc337-saas
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=false
KAFKA_TOPIC=tenant.orders
KAFKA_GROUP_ID=orders-inventory-worker

# Vercel invoice function
INVOICE_WORKER_SECRET=replace-with-another-long-random-secret
